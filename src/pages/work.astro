---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import Cursor from '../components/Cursor.astro';
import Scribble from '../components/Scribble.astro';
import { Image } from 'astro:assets';
import drawing from '../assets/about/fatima-drawing.png';
import mollyPeek from '../assets/fun-stuff/molly-peek.png';
import { projects } from '../data/projects';

const client = projects.filter((p) => p.group === 'client');
const spec = projects.filter((p) => p.group === 'spec');

const sections = [
  {
    id: 'out-in-the-wild',
    title: 'Out in the wild',
    theme: 'cream',
    items: client,
    intro: 'Some of the work that made the client-cut. Both the (unpolished) strategy and the production-y stuff.',
  },
  {
    id: 'spec-work',
    title: 'Real brands, spec work.',
    theme: 'red',
    items: spec,
    intro: 'Things I made for the love of the game. A peek into how my brain works, if you will.',
  },
] as const;
---

<Base title="Work" description="Campaigns, brands and collateral by Fatima Rabi, a designer in Ottawa.">
  <section class="work-hero theme-red">
    <div class="container">
      <h1 class="work-hero__title" data-hero-lines>
        <span class="line"><span>Look mom,</span></span>
        <span class="line"
          ><span
            >I made that<span class="bang">!</span><span class="bangs" aria-hidden="true" data-bangs
              ><span>!</span><span>!</span><span>!</span><span>!</span><span>!</span><span>!</span></span
            ></span
          ></span
        >
      </h1>
      <p class="work-hero__roles" data-reveal data-reveal-delay="0.35">
        Art direction <span aria-hidden="true">/</span>
        <span class="sr-only">,</span> Design <span aria-hidden="true">/</span>
        <span class="sr-only">,</span> Concept development
      </p>
    </div>
  </section>

  {
    sections.map((s, si) => (
      <section class={`work-section theme-${s.theme}`} id={s.id} aria-labelledby={`${s.id}-title`}>
        <div class="container">
          <header class="work-section__head">
            <h2 class="work-section__title" id={`${s.id}-title`} data-reveal>
              {s.title}
            </h2>
            <p class="work-section__intro" data-reveal data-reveal-delay="0.1">
              {s.intro}
            </p>
          </header>

          <ul class="work-grid" role="list">
            {s.items.map((p, i) => (
              <WorkCard project={p} eager={si === 0 && i < 2} />
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="doors theme-cream" aria-labelledby="doors-title">
    <div class="container">
      <h2 class="doors__title" id="doors-title" data-reveal>Not sick of me yet?</h2>

      <ul class="doors__list" role="list">
        <li class="door">
          <a class="door__link" href="/about">
            <span class="door__kicker" data-reveal>The person to blame for all of this</span>
            <span class="door__name" data-reveal data-reveal-delay="0.05"
              ><Scribble type="underline" draw="hover">About me</Scribble><span class="door__arrow" aria-hidden="true"
                >→</span
              ></span
            >
            <span class="door__peek door__peek--fatima" aria-hidden="true">
              <Image src={drawing} alt="" widths={[200, 400]} sizes="12rem" />
            </span>
          </a>
        </li>
        <li class="door">
          <a class="door__link" href="/fun-stuff">
            <span class="door__kicker" data-reveal>Made without a brief (and with a cat)</span>
            <span class="door__name" data-reveal data-reveal-delay="0.05"
              ><Scribble type="underline" draw="hover">The Fun Stuff</Scribble><span
                class="door__arrow"
                aria-hidden="true">→</span
              ></span
            >
            <span class="door__peek door__peek--molly" aria-hidden="true">
              <Image src={mollyPeek} alt="" widths={[240, 480]} sizes="14rem" />
            </span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <Cursor />
</Base>

<style>
  /* ---------- Hero ---------- */

  .work-hero {
    padding-block: calc(var(--header-h) + var(--space-xl)) var(--space-xl);
  }

  .work-hero__title {
    font-size: clamp(3.5rem, 2.2rem + 5vw, 6rem); /* 56 → 96 */
    line-height: 0.95;
    letter-spacing: -0.01em;
  }
  /* Each line slides up from behind a mask */
  .line {
    display: block;
  }
  .line > span {
    display: inline-block;
  }
  /* The excited exclamation marks */
  .bang,
  .bangs > span {
    display: inline-block;
    color: var(--cream);
  }
  /* Extra marks wait offstage until the headline has landed */
  :global(html.js-motion) .bangs > span {
    opacity: 0;
  }
  /* Before the reveal, each line hides behind a mask */
  :global(html.js-motion) .line:not(.is-in) {
    clip-path: inset(-0.6em -1em -0.25em -1em);
  }
  :global(html.js-motion) .line:not(.is-in) > span {
    opacity: 0;
  }

  .work-hero__roles {
    margin-top: var(--space-m);
    font-size: clamp(0.8125rem, 0.7rem + 0.45vw, 1.25rem); /* 13 → 20 */
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .work-hero__roles span[aria-hidden] {
    margin-inline: 0.35em;
  }


  /* ---------- Sections ---------- */

  .work-section {
    padding-block: var(--space-2xl);
  }
  .work-section__head {
    margin-bottom: var(--space-l);
  }
  .work-section__title {
    font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4rem); /* 40 → 64 */
    line-height: 1;
  }
  .theme-cream .work-section__title {
    color: var(--red);
  }
  .work-section__intro {
    margin-top: 1.25rem;
    max-width: 52ch;
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.125rem);
    letter-spacing: -0.01em;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: clamp(1rem, 0.4rem + 1.8vw, 2.25rem);
    padding: 0;
  }
  @media (min-width: 48rem) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  /* ---------- Pick a door: links to About and The Fun Stuff ----------
     Each link is a big row with a line under it. On hover, whoever lives
     on that page (me, or Molly) pops up from behind the line. */

  .doors {
    padding-block: var(--space-2xl);
  }
  .doors__title {
    font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4rem); /* 40 → 64 */
    line-height: 1;
    color: var(--red);
    margin-bottom: var(--space-l);
  }
  .doors__list {
    padding: 0;
    list-style: none;
    border-top: 1.5px solid currentColor;
  }

  .door__link {
    position: relative;
    display: grid;
    gap: 0.35rem;
    padding-block: var(--space-l) var(--space-m);
    padding-right: clamp(7rem, 18vw, 15rem); /* room for the peeker */
    border-bottom: 1.5px solid currentColor;
    color: inherit;
    text-decoration: none;
  }
  .door__kicker {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--blue-deep);
  }
  .door__name {
    font-family: var(--font-serif);
    font-size: var(--step-4);
    line-height: 1;
    color: var(--red);
  }
  .door__arrow {
    display: inline-block;
    margin-left: 0.3em;
    transition: transform var(--dur) var(--ease-out);
  }
  .door__link:hover .door__arrow,
  .door__link:focus-visible .door__arrow {
    transform: translateX(0.3em);
  }

  /* Each peeker waits in a window that sits on the line. Anything below the
     line is cut off, so they look like they're climbing up from behind it. */
  .door__peek {
    position: absolute;
    right: 0;
    bottom: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .door__peek :global(img) {
    display: block;
    width: 100%;
    height: auto;
    translate: 0 101%;
    transition: translate var(--dur) var(--ease-out);
  }
  .door__peek--fatima {
    width: clamp(7rem, 14vw, 11rem);
  }
  .door__peek--fatima :global(img) {
    rotate: -3deg;
    transform-origin: bottom center;
  }
  .door__peek--molly {
    width: clamp(7.5rem, 15vw, 12.5rem);
  }
  .door__peek--molly :global(img) {
    mix-blend-mode: multiply; /* her white background melts into the cream */
  }
  .door__link:hover .door__peek--fatima :global(img),
  .door__link:focus-visible .door__peek--fatima :global(img) {
    translate: 0 50%;
  }
  .door__link:hover .door__peek--molly :global(img),
  .door__link:focus-visible .door__peek--molly :global(img) {
    translate: 0 28%;
  }

  /* Phones: a touch smaller so the arrow stays on the same line */
  @media (max-width: 30rem) {
    .door__link {
      padding-right: 6rem;
    }
    .door__name {
      font-size: min(var(--step-4), 10.5vw);
      white-space: nowrap;
    }
    .door__peek--fatima,
    .door__peek--molly {
      width: 6rem;
    }
  }

  /* Touch screens can't hover, so the peekers are always a little bit up */
  @media (hover: none) {
    .door__peek--fatima :global(img) {
      translate: 0 68%;
    }
    .door__peek--molly :global(img) {
      translate: 0 48%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .door__peek :global(img),
    .door__arrow {
      transition: none;
    }
  }
</style>
