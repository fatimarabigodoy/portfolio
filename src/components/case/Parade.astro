---
/**
 * A parade of illustrations that strolls across the screen forever, like the
 * Home page logo strip (same moving parts: src/scripts/marquee.ts, started in
 * src/scripts/case.ts). Each one bobs as it walks; hovering one makes it hop
 * and shows its name.
 *
 *   <Parade label="Yukon wildlife" items={[{ name: 'Moose', image: moose, size: 1 }]} />
 *
 * size = height compared with the biggest (1). flip = mirror it so it faces
 * the way the parade walks. float = it flies, so it rides higher.
 * With "reduce motion" on, nothing moves: they stand in centred rows.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface ParadeItem {
  name: string;
  image: ImageMetadata;
  size?: number;
  flip?: boolean;
  float?: boolean;
}

interface Props {
  items: ParadeItem[];
  /** What they are, for the pause button: "Pause the {label}" */
  label: string;
}

const { items, label } = Astro.props;
---

<div class="parade" data-parade>
  <div class="parade__viewport">
    <div class="parade__track" data-marquee-track>
      {
        [0, 1].map((copy) => (
          <ul class="parade__list" role="list" aria-hidden={copy ? 'true' : undefined}>
            {items.map((item, i) => (
              <li
                class:list={['parade__item', { 'parade__item--float': item.float }]}
                style={`--size: ${item.size ?? 1}; --i: ${i}`}
              >
                <span class="parade__name" aria-hidden="true">
                  {item.name}
                </span>
                <span class="parade__bob">
                  <Image
                    src={item.image}
                    alt={copy ? '' : item.name}
                    widths={[Math.round(item.image.width / 2), item.image.width]}
                    sizes={`${Math.round(item.image.width / 2)}px`}
                    loading="eager"
                    decoding="async"
                    class:list={{ 'is-flipped': item.flip }}
                  />
                </span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <button class="parade__toggle" type="button" data-marquee-toggle aria-pressed="false">
    <span class="sr-only" data-marquee-label>Pause the {label}</span>
    <svg viewBox="0 0 16 16" aria-hidden="true" class="icon-pause"><path d="M5 3v10M11 3v10"></path></svg>
    <svg viewBox="0 0 16 16" aria-hidden="true" class="icon-play"><path d="M5 3l8 5-8 5z"></path></svg>
  </button>
</div>

<style>
  .parade {
    display: flex;
    flex-direction: column;
    --tallest: clamp(6.5rem, 4rem + 7vw, 11rem);
  }

  .parade__viewport {
    overflow: hidden;
    /* room above for hops and name tags */
    padding-top: 3.5rem;
    margin-top: -3.5rem;
    /* soft fade at both ends */
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }

  .parade__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .parade__list {
    display: flex;
    align-items: flex-end; /* everyone stands on the same ground */
    gap: var(--gap);
    padding: 0 calc(var(--gap) / 2);
    --gap: clamp(2.5rem, 1.5rem + 5vw, 6rem);
  }

  .parade__item {
    position: relative;
    flex: none;
    list-style: none;
  }
  .parade__item--float {
    margin-bottom: calc(var(--tallest) * 0.45);
  }
  .parade__item :global(img) {
    display: block;
    height: calc(var(--tallest) * var(--size));
    width: auto;
    max-width: none;
  }
  .parade__item :global(img.is-flipped) {
    scale: -1 1;
  }

  /* Name tag that pops up above the animal on hover */
  .parade__name {
    position: absolute;
    bottom: 100%;
    left: 50%;
    padding: 0.25em 0.75em 0.3em;
    border-radius: var(--radius-pill);
    background: var(--red);
    color: var(--cream);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    translate: -50% 0.4rem;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      translate var(--dur) var(--ease-out);
    pointer-events: none;
  }
  .parade__item:hover .parade__name {
    opacity: 1;
    translate: -50% -0.6rem;
  }

  .parade__bob {
    display: block;
  }

  /* Pause / play: small circle tucked under the end of the strip */
  .parade__toggle {
    align-self: flex-end;
    margin-top: var(--space-xs);
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--ink) 35%, transparent);
    color: var(--ink);
    opacity: 0.55;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .parade__toggle:hover,
  .parade__toggle:focus-visible {
    opacity: 1;
    background: color-mix(in srgb, var(--cream) 40%, transparent);
  }
  .parade__toggle svg {
    width: 0.8rem;
    height: 0.8rem;
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .icon-play,
  .parade__toggle[aria-pressed='true'] .icon-pause {
    display: none;
  }
  .parade__toggle[aria-pressed='true'] .icon-play {
    display: block;
  }

  /* With motion allowed: a little walking bob (fliers drift more), a hop on hover */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js-motion) .parade__bob {
      animation: parade-bob 1.1s ease-in-out infinite alternate;
      animation-delay: calc(var(--i) * -0.37s);
    }
    :global(html.js-motion) .parade__item--float .parade__bob {
      animation: parade-fly 2.2s ease-in-out infinite alternate;
    }
    .parade__item:hover .parade__bob {
      animation: parade-hop 0.55s var(--ease-out) both !important;
    }
    /* paused strip = everyone stands still */
    .parade:has(.parade__toggle[aria-pressed='true']) .parade__bob {
      animation-play-state: paused;
    }
  }
  @keyframes parade-bob {
    from {
      translate: 0 0;
    }
    to {
      translate: 0 -4%;
    }
  }
  @keyframes parade-fly {
    from {
      translate: 0 -10%;
      rotate: -4deg;
    }
    to {
      translate: 0 10%;
      rotate: 4deg;
    }
  }
  @keyframes parade-hop {
    0% {
      translate: 0 0;
    }
    40% {
      translate: 0 -22%;
    }
    100% {
      translate: 0 0;
    }
  }

  /* No motion: one copy, they stand in centred rows, no button */
  :global(html:not(.js-motion)) .parade__track {
    width: auto;
  }
  :global(html:not(.js-motion)) .parade__list {
    flex-wrap: wrap;
    justify-content: center;
    row-gap: var(--space-l);
    padding-inline: var(--gutter);
  }
  :global(html:not(.js-motion)) .parade__list[aria-hidden],
  :global(html:not(.js-motion)) .parade__toggle {
    display: none;
  }
  :global(html:not(.js-motion)) .parade__viewport {
    mask-image: none;
  }
</style>
