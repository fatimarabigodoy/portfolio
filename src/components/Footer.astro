---
import Scribble from './Scribble.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer theme-red" data-header-theme="red">
  <div class="container">
    <p class="eyebrow footer-eyebrow" data-reveal>Got a project in mind?</p>
    <div class="footer-title-wrap">
      <h2 class="footer-title" data-reveal>
        Let’s make something <Scribble type="circle" delay={0.3}>together.</Scribble>
      </h2>
    </div>

    <div class="footer-cta" data-reveal>
      <button class="btn copy-email" type="button" data-copy-email={btoa(site.email)}>
        <span data-copy-label>Copy my email</span>
      </button>
      {
        site.socials.map((s) => (
          <a class="btn btn--outline" href={s.href} target="_blank" rel="noopener">
            {s.label} <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </div>

  <div class="container footer-legal">
    <p>© {year} {site.name}</p>
    <button class="to-top" type="button" data-to-top>
      Back to top <span aria-hidden="true">↑</span>
    </button>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding-top: var(--space-2xl);
    overflow: hidden;
  }

  .footer-eyebrow {
    margin-bottom: var(--space-s);
  }

  .footer-title {
    font-size: var(--step-5);
    line-height: 0.95;
    max-width: 12ch;
  }
  /* Wide screens: one line that spans the full width exactly.
     The size is the column width divided by how many "font sizes" wide the
     sentence is (measured: 10.18). Re-measure if the words change. */
  @media (min-width: 48rem) {
    .footer-title-wrap {
      container-type: inline-size;
    }
    .footer-title {
      max-width: none;
      white-space: nowrap;
      font-size: calc(100cqi / 10.18);
    }
  }

  .footer-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin-top: var(--space-l);
  }

  .btn--outline {
    background: transparent;
    color: var(--cream);
    box-shadow: inset 0 0 0 1.5px currentColor;
  }
  .theme-red .btn--outline:hover {
    background: var(--cream);
    color: var(--red);
  }
  .to-top span {
    display: inline-block;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .to-top:hover span {
    transform: translateY(-3px);
  }

  .footer-legal {
    margin-top: var(--space-xl);
    display: flex;
    justify-content: space-between;
    gap: var(--space-m);
    padding-block: var(--space-m);
    font-size: var(--step--1);
  }
  .footer-legal p {
    opacity: 0.6;
  }
</style>
