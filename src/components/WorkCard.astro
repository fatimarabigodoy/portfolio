---
/**
 * One project card on the Work page.
 *
 * With a cover image it's a link: blue duotone at rest, full colour on
 * hover / keyboard focus (and on phones, when it reaches the middle of the screen).
 * The short description stays tucked away and slides open at the same moment.
 * Without a cover it's a "sketchbook" card: the project is listed but its
 * case study isn't ready yet.
 */
import { Picture } from 'astro:assets';
import type { Project } from '../data/projects';
import { widthsFor } from '../utils/image';

interface Props {
  project: Project;
  eager?: boolean;
}

const { project: p, eager = false } = Astro.props;
const linked = Boolean(p.cover && p.hasPage);
const Tag = linked ? 'a' : 'div';
const titleId = `card-${p.slug}-title`;
const textId = `card-${p.slug}-text`;

// *words in stars* → italics. Everything else is escaped.
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const summary = p.summary ? escape(p.summary).replace(/\*(.+?)\*/g, '<em>$1</em>') : '';
---

<li class="work-item" data-card data-tag={p.tag.toLowerCase()}>
  <Tag
    class:list={['card', p.cover ? 'card--image' : 'card--sketch']}
    href={linked ? `/work/${p.slug}` : undefined}
    aria-labelledby={linked ? titleId : undefined}
    aria-describedby={linked ? textId : undefined}
    data-card-link={linked ? '' : undefined}
    data-cta={linked ? (p.cta ?? 'View project') : undefined}
    style={p.cover ? `--focus: ${p.focus ?? '50% 50%'}` : undefined}
  >
    {
      p.cover && (
        <div class="card__media" aria-hidden="true">
          <div class="card__img" data-card-parallax>
            <Picture
              src={p.cover}
              alt=""
              formats={['avif', 'webp']}
              widths={widthsFor(p.cover!, [600, 900, 1200, 1600])}
              sizes="(min-width: 48rem) min(45vw, 600px), 125vw"
              loading={eager ? 'eager' : 'lazy'}
            />
          </div>
        </div>
      )
    }

    <div class="card__body">
      <div class="card__top">
        <span class="card__tag">{p.tag}</span>
        {linked && <span class="card__cta" aria-hidden="true">{p.cta ?? 'View project'}</span>}
      </div>
      <div class="card__copy">
        <h3 class="card__title" id={titleId}>{p.title}</h3>
        <div class="card__reveal">
          {
            summary ? (
              <p class="card__text" id={textId} set:html={summary} />
            ) : (
              <p class="card__text" id={textId}>
                Still in the sketchbook. Case study coming soon.
              </p>
            )
          }
        </div>
      </div>
    </div>
  </Tag>
</li>

<style>
  .work-item {
    list-style: none;
  }

  .card {
    position: relative;
    display: grid;
    aspect-ratio: 582 / 590;
    border-radius: 12px;
    overflow: hidden;
    color: var(--cream);
    isolation: isolate;
  }

  .card__body {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-l);
    padding: clamp(1.25rem, 0.8rem + 1.6vw, 2.25rem);
  }

  .card__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-2xs);
    width: 100%;
  }

  /* Phones only: the project's playful line pops in when the card is centred.
     (With a mouse, the same line follows the cursor instead; see work.astro.) */
  .card__cta {
    display: none;
    padding: 0.45em 1em;
    border-radius: var(--radius-pill);
    background: var(--cream);
    color: var(--red);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.1;
    white-space: nowrap;
    opacity: 0;
    scale: 0.6;
    transition:
      opacity 0.3s var(--ease-out),
      scale 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @media (hover: none) {
    .card__cta {
      display: block;
    }
    .card.is-live .card__cta {
      opacity: 1;
      scale: 1;
    }
  }

  .card__tag {
    padding: 0.2rem 0.85rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .card__copy {
    max-width: 19rem;
  }
  .card__title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(1.625rem, 1.3rem + 1vw, 2.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  /* Description: tucked away, slides open on hover / focus / phone centre */
  .card__reveal {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.55s var(--ease-out),
      opacity 0.35s var(--ease-out);
  }
  .card__reveal > * {
    min-height: 0;
    overflow: hidden;
  }
  .card:is(:hover, :focus-visible, .is-live) .card__reveal {
    grid-template-rows: 1fr;
    opacity: 1;
    transition-delay: 0s, 0.12s;
  }
  .card__text {
    padding-top: 0.5rem;
    font-size: clamp(0.9375rem, 0.9rem + 0.12vw, 1rem);
    line-height: 1.5;
  }

  /* ---------- Image cards ---------- */

  .card__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--blue);
  }
  /* A little taller than the card so it can drift as you scroll */
  .card__img {
    position: absolute;
    inset: -6% 0;
  }
  .card__img :global(picture) {
    display: block;
    height: 100%;
  }
  .card__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus);
    transform-origin: var(--focus);
    transform: none;
    filter: grayscale(1) contrast(1.08);
    transition:
      filter 0.7s var(--ease-out),
      transform 1.1s var(--ease-out);
  }
  /* The blue duotone: grey image × light blue */
  .card__media::after,
  .card__media::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: opacity 0.7s var(--ease-out);
  }
  .card__media::before {
    z-index: 1;
    background: var(--blue);
    mix-blend-mode: multiply;
  }
  /* Deep-blue shade behind the text so it's always readable */
  .card__media::after {
    z-index: 2;
    background:
      linear-gradient(to bottom, rgb(20 34 64 / 0.35), transparent 22%),
      linear-gradient(to top, rgb(20 34 64 / 0.88), rgb(20 34 64 / 0.5) 32%, transparent 62%);
  }

  /* Full colour on hover, keyboard focus, or (phones) when centred on screen */
  .card--image:is(:hover, :focus-visible, .is-live) .card__img :global(img) {
    filter: grayscale(0) contrast(1);
    transform: scale(1.05);
  }
  .card--image:is(:hover, :focus-visible, .is-live) .card__media::before {
    opacity: 0;
  }

  .card--image:focus-visible {
    outline: 3px solid var(--blue-deep);
    outline-offset: 5px;
    border-radius: 12px;
  }
  :global(.theme-red) .card--image:focus-visible {
    outline-color: var(--blue);
  }

  /* ---------- Sketchbook cards (no case study yet) ---------- */

  .card--sketch {
    background: color-mix(in srgb, var(--cream) 6%, transparent);
    border: 1.5px dashed color-mix(in srgb, var(--cream) 45%, transparent);
  }
  /* A faint pencil hatch in the corner */
  .card--sketch::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: repeating-linear-gradient(
      -45deg,
      color-mix(in srgb, var(--cream) 7%, transparent) 0 1.5px,
      transparent 1.5px 14px
    );
    mask-image: radial-gradient(circle at 100% 0%, #000, transparent 55%);
    pointer-events: none;
  }

  @media (max-width: 47.99rem) {
    .card {
      aspect-ratio: 4 / 5;
    }
    .card--sketch {
      aspect-ratio: 16 / 11;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card__cta,
    .card.is-live .card__cta {
      scale: 1;
    }
    .card__img :global(img) {
      transition: filter 0.4s linear;
    }
    .card--image:is(:hover, :focus-visible, .is-live) .card__img :global(img) {
      transform: none;
    }
  }
</style>
