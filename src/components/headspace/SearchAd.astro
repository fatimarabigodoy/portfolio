---
/**
 * Headspace: the search ad, on a phone in bed at 2:47 a.m.
 *
 * Her photo (hand holding a phone, blank screen) with a search page built in
 * code corner-pinned onto the screen (src/scripts/headspace.ts). It types the
 * query, the suggestions pile up, the results load with Headspace on top, then
 * the ad gets tapped and the browser's tab count rolls down from 57.
 *
 * The markup below is the finished results page, so with reduced motion that's
 * what shows, still. The search engine is generic on purpose (no real logos).
 */
import { Picture } from 'astro:assets';
import { widthsFor } from '../../utils/image';
import photo from '../../assets/headspace/phone.jpg';

const query = 'why can’t i turn my brain off';

// Suggestions, in two waves while it types (after "why can" / after "why can’t i turn")
const early = ['why can’t i sleep', 'why can’t i stop overthinking', 'why can’t i focus on anything'];
const late = [
  'why can’t i turn my brain off at night',
  'why can’t i turn my brain off reddit',
  'why can’t i turn off my thoughts',
  'why can’t i turn my brain off when i’m tired',
];

// Keyboard rows
const rows = ['qwertyuiop', 'asdfghjkl', 'zxcvbnm'];

// Screen corners in the cropped photo (% of 1800 × 2250): TL, TR, BR, BL
const quad = [
  [34.56, 23.73],
  [72.67, 23.78],
  [72.17, 89.6],
  [34.28, 89.42],
];
---

<figure class="ad" data-ad>
  <div class="ad__frame">
    <Picture
      src={photo}
      alt=""
      formats={['avif', 'webp']}
      widths={widthsFor(photo)}
      sizes="(min-width: 56rem) 40vw, calc(100vw - 2 * var(--gutter))"
      quality={88}
      loading="lazy"
      class="ad__photo"
    />

    <div
      class="ad__screen"
      data-ad-screen
      data-quad={JSON.stringify(quad)}
      data-query={query}
      data-early={JSON.stringify(early)}
      data-late={JSON.stringify(late)}
      role="img"
      aria-label={`A phone search for “${query}” at 2:47 a.m. The top result is a sponsored Headspace ad: Close your mental tabs. The browser shows 57 open tabs.`}
    >
      <div class="ad__status" aria-hidden="true">
        <span class="ad__time">2:47</span>
        <span class="ad__sys">
          <svg viewBox="0 0 18 12"><path d="M1 11h2V8H1zm4 0h2V6H5zm4 0h2V3H9zm4 0h2V1h-2z" /></svg>
          <svg viewBox="0 0 24 24" class="ad__wifi" fill="none"><path d="M3 9a13 13 0 0 1 18 0M6.5 12.5a8 8 0 0 1 11 0M10 16a3 3 0 0 1 4 0" /></svg>
          <span class="ad__battery"><span /></span>
        </span>
      </div>
      <div class="ad__notch" aria-hidden="true"></div>

      <div class="ad__page" aria-hidden="true">
        <div class="ad__field">
          <svg viewBox="0 0 24 24" class="ad__icon"><circle cx="10" cy="10" r="6.5" /><path d="M15 15l5.5 5.5" /></svg>
          <span class="ad__input" data-ad-input>{query}</span>
          <svg viewBox="0 0 24 24" class="ad__icon ad__clear"><path d="M7 7l10 10M17 7L7 17" /></svg>
        </div>

        <!-- While typing: suggestions -->
        <ul class="ad__suggest" data-ad-suggest>
          {
            [...early, ...late].map((s, i) => (
              <li data-wave={i < early.length ? 'early' : 'late'}>
                <svg viewBox="0 0 24 24" class="ad__icon">
                  <circle cx="10" cy="10" r="6.5" />
                  <path d="M15 15l5.5 5.5" />
                </svg>
                <span>{s}</span>
              </li>
            ))
          }
        </ul>

        <!-- The results -->
        <div class="ad__results" data-ad-results>
          <p class="ad__chips"><b>All</b><span>Images</span><span>News</span><span>Videos</span><span>Forums</span></p>

          <article class="ad__card ad__card--ad" data-ad-card>
            <p class="ad__sponsored">Sponsored</p>
            <p class="ad__site">
              <span class="ad__fav"></span>
              <span><b>Headspace</b><small>headspace.com</small></span>
            </p>
            <p class="ad__title">Close your mental tabs.</p>
            <p class="ad__desc">
              Your brain has 57 tabs open. Ten minutes won’t close all of them, but it’s a start.
            </p>
            <span class="ad__cta">Try it tonight</span>
          </article>

          <div class="ad__card" data-ad-other>
            <p class="ad__label">People also ask</p>
            <p class="ad__ask">Is it normal to overthink at 3 a.m.?</p>
            <p class="ad__ask">Why does my brain replay embarrassing moments?</p>
            <p class="ad__ask">Can you overthink yourself awake?</p>
          </div>

          <div class="ad__card" data-ad-other>
            <p class="ad__site ad__site--plain"><span><b>r/insomnia</b><small>2.1k comments</small></span></p>
            <p class="ad__title ad__title--plain">it’s 3am and i’m thinking about something i said in 2014</p>
          </div>

          <div class="ad__card" data-ad-other>
            <p class="ad__site ad__site--plain"><span><b>wellness-ish.blog</b><small>12 min read</small></span></p>
            <p class="ad__title ad__title--plain">11 reasons your brain won’t shut up (number 7 will keep you up)</p>
          </div>
        </div>
      </div>

      <!-- Browser toolbar with the tab count -->
      <div class="ad__bar" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="ad__icon"><path d="M15 5l-7 7 7 7" /></svg>
        <svg viewBox="0 0 24 24" class="ad__icon ad__dim"><path d="M9 5l7 7-7 7" /></svg>
        <svg viewBox="0 0 24 24" class="ad__icon"><path d="M12 4v16M4 12h16" /></svg>
        <span class="ad__tabs" data-ad-tabs>57</span>
      </div>

      <div class="ad__keys" data-ad-keys aria-hidden="true">
        {
          rows.map((r) => (
            <div class="ad__row">
              {[...r].map((k) => (
                <span class="ad__key" data-key={k}>
                  {k}
                </span>
              ))}
            </div>
          ))
        }
        <div class="ad__row">
          <span class="ad__key ad__key--wide ad__key--grey">123</span>
          <span class="ad__key ad__key--space" data-key=" ">space</span>
          <span class="ad__key ad__key--wide ad__key--go">go</span>
        </div>
        <span class="ad__home"></span>
      </div>

      <span class="ad__finger" data-ad-finger aria-hidden="true"></span>
    </div>
  </div>
</figure>

<style>
  .ad__frame {
    position: relative;
    aspect-ratio: 1800 / 2250;
    overflow: hidden;
    border-radius: 12px;
    background: #1a1512;
  }
  .ad__photo,
  .ad__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- The phone screen (designed at 300 × 647, then pinned) ---------- */

  .ad__screen {
    position: absolute;
    top: 0;
    left: 0;
    width: 300px;
    height: 647px;
    overflow: hidden;
    border-radius: 36px;
    background: #fff;
    color: #202124;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.35;
    letter-spacing: -0.005em;
    visibility: hidden;
    backface-visibility: hidden;
    user-select: none;
    -webkit-user-select: none;
  }
  .ad__screen.is-pinned {
    visibility: visible;
  }

  .ad__notch {
    position: absolute;
    top: 0;
    left: 50%;
    width: 51%;
    height: 27px;
    translate: -50% 0;
    border-radius: 0 0 17px 17px;
    background: #0c0c0d;
    z-index: 6;
  }
  .ad__status {
    position: absolute;
    inset: 0 0 auto;
    z-index: 5;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 30px;
    padding: 2px 17px 0 28px;
    font-size: 13px;
    font-weight: 650;
  }
  .ad__sys {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }
  .ad__sys svg {
    width: 12px;
    height: 10px;
    fill: currentColor;
  }
  .ad__sys .ad__wifi {
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .ad__battery {
    position: relative;
    width: 19px;
    height: 10px;
    padding: 1.5px;
    border: 1px solid rgb(32 33 36 / 0.45);
    border-radius: 3.5px;
  }
  .ad__battery > span {
    display: block;
    width: 18%;
    height: 100%;
    border-radius: 1.5px;
    background: #e5484d;
  }

  .ad__page {
    position: absolute;
    inset: 34px 0 0;
    padding: 6px 12px 0;
  }
  .ad__icon {
    flex: none;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ad__field {
    display: flex;
    align-items: center;
    gap: 9px;
    height: 40px;
    padding: 0 13px;
    border-radius: 20px;
    background: #f1f3f4;
    font-size: 14px;
  }
  .ad__input {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .ad__input:empty::before {
    content: 'Search';
    color: #80868b;
  }
  .ad__screen.is-typing .ad__input::after {
    content: '';
    display: inline-block;
    width: 1.5px;
    height: 1.05em;
    margin-left: 1px;
    vertical-align: -0.18em;
    background: #1a73e8;
  }
  .ad__screen.is-typing .ad__input:empty::before {
    content: none;
  }
  .ad__clear {
    color: #5f6368;
  }

  .ad__suggest {
    position: absolute;
    inset: 52px 0 auto;
    margin: 0;
    padding: 4px 0;
    list-style: none;
    opacity: 0;
  }
  .ad__suggest li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 9px 26px;
    font-size: 14px;
    color: #202124;
  }
  .ad__suggest .ad__icon {
    color: #5f6368;
  }
  .ad__suggest li[hidden] {
    display: none;
  }

  .ad__results {
    padding-top: 10px;
  }
  .ad__chips {
    display: flex;
    gap: 16px;
    padding: 0 6px 10px;
    border-bottom: 1px solid #e8eaed;
    font-size: 12.5px;
    color: #5f6368;
  }
  .ad__chips b {
    color: #1a73e8;
    font-weight: 600;
    box-shadow: inset 0 -2px 0 #1a73e8;
    padding-bottom: 8px;
    margin-bottom: -10px;
  }
  .ad__card {
    padding: 12px 6px;
    border-bottom: 1px solid #e8eaed;
  }
  .ad__card--ad {
    position: relative;
    border-radius: 12px;
    transition: background-color 0.2s;
  }
  .ad__card--ad.is-pressed {
    background: #f1f3f4;
  }
  .ad__sponsored {
    font-size: 11.5px;
    font-weight: 700;
    color: #202124;
  }
  .ad__site {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 6px;
    font-size: 12px;
  }
  .ad__site > span {
    display: grid;
    line-height: 1.25;
  }
  .ad__site small {
    font-size: 11px;
    color: #5f6368;
  }
  .ad__site--plain {
    margin-top: 0;
  }
  .ad__fav {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #fff4ec;
    box-shadow: inset 0 0 0 1px #f3e3d6;
    position: relative;
  }
  .ad__fav::after {
    content: '';
    position: absolute;
    inset: 6px;
    border-radius: 50%;
    background: #ff7300;
  }
  .ad__title {
    margin-top: 7px;
    font-size: 17px;
    line-height: 1.25;
    color: #1a0dab;
  }
  .ad__title--plain {
    margin-top: 5px;
    font-size: 15px;
  }
  .ad__desc {
    margin-top: 4px;
    font-size: 12.5px;
    color: #4d5156;
  }
  .ad__cta {
    display: inline-block;
    margin-top: 10px;
    padding: 6px 14px;
    border-radius: 999px;
    background: #ff7300;
    color: #fff;
    font-size: 12.5px;
    font-weight: 650;
  }
  .ad__label {
    font-size: 14px;
    font-weight: 600;
  }
  .ad__ask {
    padding: 9px 0;
    border-top: 1px solid #e8eaed;
    font-size: 13px;
  }
  .ad__ask:first-of-type {
    margin-top: 8px;
  }

  /* Browser toolbar */
  .ad__bar {
    position: absolute;
    inset: auto 0 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 58px;
    padding: 0 26px 14px;
    background: #fafafa;
    border-top: 1px solid #e8eaed;
    color: #1a73e8;
  }
  .ad__bar .ad__icon {
    width: 20px;
    height: 20px;
  }
  .ad__dim {
    color: #c4c7c5;
  }
  .ad__tabs {
    display: grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 3px;
    border: 2px solid currentColor;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  /* Keyboard */
  .ad__keys {
    position: absolute;
    inset: auto 0 0;
    z-index: 4;
    display: grid;
    gap: 9px;
    padding: 8px 3px 26px;
    background: #d2d5db;
    translate: 0 100%;
  }
  .ad__row {
    display: flex;
    justify-content: center;
    gap: 5px;
  }
  .ad__row:nth-child(2) {
    padding-inline: 13px;
  }
  .ad__key {
    flex: 1 1 0;
    max-width: 25px;
    display: grid;
    place-items: center;
    height: 36px;
    border-radius: 5px;
    background: #fff;
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.28);
    font-size: 16px;
    transition: background-color 0.12s;
  }
  .ad__row:nth-child(3) {
    padding-inline: 38px;
  }
  .ad__key.is-down {
    background: #aeb3bc;
  }
  .ad__key--wide {
    flex: 0 0 64px;
    max-width: none;
    font-size: 13px;
  }
  .ad__key--grey {
    background: #abb0ba;
  }
  .ad__key--space {
    flex: 1 1 auto;
    max-width: none;
    font-size: 13px;
    color: #555;
  }
  .ad__key--go {
    background: #1a73e8;
    color: #fff;
  }
  .ad__home {
    position: absolute;
    left: 50%;
    bottom: 8px;
    width: 110px;
    height: 4px;
    translate: -50% 0;
    border-radius: 2px;
    background: #111;
  }

  /* The tap */
  .ad__finger {
    position: absolute;
    z-index: 7;
    top: 0;
    left: 0;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    border-radius: 50%;
    background: rgb(32 33 36 / 0.22);
    border: 1.5px solid rgb(255 255 255 / 0.7);
    opacity: 0;
    pointer-events: none;
  }
  .ad__card--ad {
    cursor: pointer;
  }
</style>
